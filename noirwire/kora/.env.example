# Variables of the Kora service. Placeholders only: set the real values in Railway, never in a file.

# Mainnet RPC endpoint, API key included.
RPC_URL=https://YOUR_MAINNET_RPC_URL

# The fee payer's secret key: the JSON byte array solana-keygen writes, or its base58 form. SECRET.
KORA_PRIVATE_KEY=REPLACE_WITH_FEE_PAYER_SECRET_KEY

# Both are required on every request. Generate each with: openssl rand -hex 32. SECRET.
KORA_API_KEY=REPLACE_WITH_64_HEX_CHARACTERS
KORA_HMAC_SECRET=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS

# Kora reads token prices from Jupiter and refuses to start without this. SECRET.
JUPITER_API_KEY=REPLACE_WITH_JUPITER_API_KEY

# Keep at warn: at info Kora logs every transaction it is sent.
RUST_LOG=warn
PORT=8080
