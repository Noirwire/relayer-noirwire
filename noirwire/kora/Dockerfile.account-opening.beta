# Kora fee relayer, PRE-RELEASE variant that may fund new token accounts. Not the default.
# Pinned by digest: v2.2.0-beta.8, linux/amd64 and linux/arm64 manifest list.
FROM ghcr.io/solana-foundation/kora:v2.2.0-beta.8@sha256:1b929cd9b32e6a3dddb646669fbe0d30651e07377b2bface044cd84289df59bf
WORKDIR /app
COPY kora.account-opening.beta.toml ./kora.toml
COPY signers.toml ./
# Shell form so the platform's PORT is honoured. RPC_URL, KORA_PRIVATE_KEY, KORA_API_KEY, KORA_HMAC_SECRET,
# JUPITER_API_KEY and RUST_LOG come from the service's variables.
CMD kora --config /app/kora.toml rpc start --signers-config /app/signers.toml --port ${PORT:-8080}
