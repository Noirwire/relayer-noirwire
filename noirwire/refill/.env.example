# Variables of the refill job. Placeholders only: set the real values in Railway, never in a file.

# Mainnet RPC endpoint, API key included.
RPC_URL=https://YOUR_MAINNET_RPC_URL

# The PAYMENT wallet's secret key (JSON byte array or base58). SECRET.
# The fee payer's key is never given to this job.
PAYMENT_WALLET_PRIVATE_KEY=REPLACE_WITH_PAYMENT_WALLET_SECRET_KEY

# The fee payer's PUBLIC key. The only address this job ever sends SOL to.
FEE_PAYER=REPLACE_WITH_FEE_PAYER_PUBLIC_KEY

# REQUIRED, no default: the most USDC the job may ever pay for one SOL, whatever any price
# source says. Set it to about twice the current SOL price and revisit it when the price moves.
MAX_USDC_PER_SOL=REPLACE_WITH_ABOUT_TWICE_THE_SOL_PRICE

# Only for the very first refill, before the fee payer has relayed anything: repeat the
# FEE_PAYER address here. Remove it after the first relayed transaction.
# FEE_PAYER_UNSEEN_OK=REPLACE_WITH_FEE_PAYER_PUBLIC_KEY

# Optional. Without it Jupiter answers at its lower keyless rate limit. SECRET.
JUPITER_API_KEY=REPLACE_WITH_JUPITER_API_KEY

# Tunables, shown with their defaults.
TARGET_SOL=0.1
REFILL_BELOW_SOL=0.03
MAX_USDC_PER_RUN=15
MAX_RUNS_PER_DAY=6
USDC_FLOOR=1
PAYMENT_WALLET_SOL_RESERVE=0.01
MAX_SLIPPAGE_BPS=100

# 1: read, quote and check everything, sign and send nothing.
DRY_RUN=0
