# Variables of the gateway. Placeholders only: set the real values in the platform, never in a file.

# RPC endpoint of the network the customers' relayers run on, API key included.
RPC_URL=https://YOUR_MAINNET_RPC_URL

# REQUIRED, no default: "postgres" in production, "memory" for one local process only
# (it forgets quotes, budgets and what was already signed on every restart).
STORE=postgres
# Required with STORE=postgres. Apply migrations/001_gateway.sql first. SECRET.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Path of the customers file (public fields only, see customers.example.json).
CUSTOMERS_FILE=/app/customers.json

# Three secrets per customer, named by the customer's id in upper case with "-" as "_".
# For a customer with id "example-app". Generate each with: openssl rand -hex 32. SECRET.
GATEWAY_HMAC_SECRET_EXAMPLE_APP=REPLACE_WITH_64_HEX_CHARACTERS_SHARED_WITH_THE_CUSTOMER
KORA_API_KEY_EXAMPLE_APP=REPLACE_WITH_THE_KORA_API_KEY_OF_THIS_CUSTOMERS_KORA
KORA_HMAC_SECRET_EXAMPLE_APP=REPLACE_WITH_THE_KORA_HMAC_SECRET_OF_THIS_CUSTOMERS_KORA

# Tunables, shown with their defaults.
PORT=8787
# The USDC mint of the network. This is mainnet's; set the devnet mint on devnet.
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Compute unit limit set on (and the most allowed in) a transaction that carries a priority fee.
COMPUTE_UNIT_LIMIT=30000
# The highest priority fee a client may ask for, in micro-lamports per compute unit. 0 forbids them.
MAX_PRIORITY_MICRO_LAMPORTS=500000
# The highest network cost the gateway will quote or sign against, in micro-USDC (0.10 USDC).
MAX_NETWORK_COST_MICRO_USDC=100000
# Quoted on top of the network cost so a price tick between prepare and sign does not refuse
# the quote. 0 quotes the exact cost. See "Price movement" in README.md.
COST_BUFFER_BPS=0
QUOTE_TTL_SECONDS=45
MAX_PRICE_AGE_SECONDS=60
# Bound on every call to the RPC, to Kora and to the database.
UPSTREAM_TIMEOUT_MS=15000
